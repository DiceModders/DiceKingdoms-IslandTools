  "editor.bldgPreview": { "en": "Yellow preview = where it goes. Right-click removes. The white dot is the anchor tile.", "de": "Gelbe Vorschau = wo es hinkommt. Rechtsklick entfernt. Der weiße Punkt ist das Ankerfeld.", "fr": "Aperçu jaune = emplacement. Clic droit retire. Le point blanc est la case d'ancrage.", "ru": "Жёлтый контур — куда встанет. Правый клик убирает. Белая точка — опорная клетка.", "uk": "Жовтий контур — куди стане. Правий клік прибирає. Біла точка — опорна клітинка.", "zh-CN": "黄色预览 = 放置位置。右键移除。白点为锚点格子。" },
  "editor.hillHelp": { "en": "Click to place a hill piece, click a hill to remove it.", "de": "Klicke, um ein Hügelteil zu setzen, klicke einen Hügel, um ihn zu entfernen.", "fr": "Cliquez pour placer une pièce de colline, cliquez une colline pour la retirer.", "ru": "Нажмите, чтобы поставить часть холма; нажмите на холм, чтобы убрать его.", "uk": "Натисніть, щоб поставити частину пагорба; натисніть пагорб, щоб прибрати його.", "zh-CN": "点击放置丘陵块，点击丘陵将其移除。" },
  "editor.hillsVisible": { "en": "Make painted hills visible", "de": "Gemalte Hügel sichtbar machen", "fr": "Rendre visibles les collines peintes", "ru": "Сделать нарисованные холмы видимыми", "uk": "Зробити намальовані пагорби видимими", "zh-CN": "让绘制的丘陵可见" },
  "editor.hillsInfo": { "en": "Hills painted with the Ground brush \"Inner cliff\" are invisible in the game but still block building. The button covers them with the game's hill pieces, big ones first; leave them painted for an invisible hill.", "de": "Mit dem Bodenpinsel „Innerer Fels“ gemalte Hügel sind im Spiel unsichtbar, blockieren aber das Bauen. Der Knopf bedeckt sie mit den Hügelteilen des Spiels, große zuerst; lass sie gemalt für einen unsichtbaren Hügel.", "fr": "Les collines peintes avec le pinceau de sol « Falaise intérieure » sont invisibles en jeu mais bloquent la construction. Le bouton les couvre avec les pièces de colline du jeu, les grandes d'abord ; laissez-les peintes pour une colline invisible.", "ru": "Холмы, нарисованные кистью земли «Внутренний утёс», в игре невидимы, но мешают строить. Кнопка покрывает их частями холмов игры, сначала крупными; оставьте нарисованными, если нужен невидимый холм.", "uk": "Пагорби, намальовані пензлем землі «Внутрішня скеля», у грі невидимі, але заважають будувати. Кнопка вкриває їх частинами пагорбів гри, спершу великими; залиште намальованими, якщо потрібен невидимий пагорб.", "zh-CN": "用地面笔刷“内部悬崖”绘制的丘陵在游戏中不可见，但仍会阻挡建造。此按钮会用游戏的丘陵块覆盖它们（先放大块）；若要隐形丘陵就保持绘制状态。" },
  "editor.hillsAdded": { "en": "{0} hill piece(s) added over the painted hill tiles.", "de": "{0} Hügelteil(e) über den gemalten Hügelfeldern hinzugefügt.", "fr": "{0} pièce(s) de colline ajoutée(s) sur les cases peintes.", "ru": "Добавлено частей холма на нарисованные клетки: {0}.", "uk": "Додано частин пагорба на намальовані клітинки: {0}.", "zh-CN": "已在绘制的丘陵格子上添加 {0} 块丘陵。" },
  "editor.hillsNone": { "en": "No painted hill tiles without a piece.", "de": "Keine gemalten Hügelfelder ohne Teil.", "fr": "Aucune case de colline peinte sans pièce.", "ru": "Нет нарисованных клеток холма без части.", "uk": "Немає намальованих клітинок пагорба без частини.", "zh-CN": "没有缺少丘陵块的绘制格子。" },
  "editor.selected": { "en": "Selected player: {0}", "de": "Gewählter Spieler: {0}", "fr": "Joueur sélectionné : {0}", "ru": "Выбранный игрок: {0}", "uk": "Обраний гравець: {0}", "zh-CN": "所选玩家：{0}" },
