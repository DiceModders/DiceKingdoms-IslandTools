  "fit.unknownBuildings": { "en": " ({0} building(s) of a type this game does not have were left out: a mod's building?)", "de": " ({0} Gebäude eines Typs, den dieses Spiel nicht hat, weggelassen: ein Gebäude aus einer Mod?)", "fr": " ({0} bâtiment(s) d'un type que ce jeu n'a pas laissé(s) de côté : un bâtiment d'un mod ?)", "ru": " (пропущено зданий типа, которого нет в этой игре: {0}; здание из мода?)", "uk": " (пропущено будівель типу, якого немає в цій грі: {0}; будівля з мода?)", "zh-CN": "（略过了 {0} 个本游戏没有的类型的建筑：来自模组的建筑？）" },
  "check.modBuilding": { "en": "{0} (x{1}) comes from a mod: in a game without that mod it is left out", "de": "{0} (x{1}) stammt aus einer Mod: in einem Spiel ohne diese Mod wird es weggelassen", "fr": "{0} (x{1}) vient d'un mod : dans un jeu sans ce mod, il est laissé de côté", "ru": "«{0}» (x{1}) из мода: в игре без этого мода здание будет пропущено", "uk": "«{0}» (x{1}) з мода: у грі без цього мода будівлю буде пропущено", "zh-CN": "{0}（x{1}）来自模组：在没有该模组的游戏中会被略过" },
  "check.unknownBuilding": { "en": "Building type {0} (x{1}) is not in this game (a mod's building?): applying leaves it out", "de": "Gebäudetyp {0} (x{1}) gibt es in diesem Spiel nicht (aus einer Mod?): beim Anwenden wird es weggelassen", "fr": "Le type de bâtiment {0} (x{1}) n'existe pas dans ce jeu (un bâtiment d'un mod ?) : il est laissé de côté à l'application", "ru": "Типа здания {0} (x{1}) нет в этой игре (здание из мода?): при применении оно будет пропущено", "uk": "Типу будівлі {0} (x{1}) немає в цій грі (будівля з мода?): під час застосування її буде пропущено", "zh-CN": "本游戏没有建筑类型 {0}（x{1}）（来自模组的建筑？）：应用时会被略过" },
  "fit.placed": { "en": " (the {0}x{0} island was placed in the middle of the {1}x{1} grid", "de": " (die Insel {0}x{0} wurde in die Mitte des Rasters {1}x{1} gesetzt", "fr": " (l'île {0}x{0} a été placée au milieu de la grille {1}x{1}", "ru": " (остров {0}x{0} поставлен в середину сетки {1}x{1}", "uk": " (острів {0}x{0} поставлено в середину сітки {1}x{1}", "zh-CN": "（{0}x{0} 的岛屿被放在 {1}x{1} 网格的中央" },
  "fit.dropped": { "en": "; {0} building(s)/cliff(s) outside it were left out", "de": "; {0} Gebäude/Felsen außerhalb wurden weggelassen", "fr": " ; {0} bâtiment(s)/falaise(s) en dehors ont été laissé(s) de côté", "ru": "; пропущено зданий/утёсов за её пределами: {0}", "uk": "; пропущено будівель/скель поза нею: {0}", "zh-CN": "；其外的 {0} 个建筑/悬崖被略过" },
